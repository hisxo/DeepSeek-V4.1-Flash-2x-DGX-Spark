--- a/zig/kernels/cuda/dsv41_ops.cu
+++ b/zig/kernels/cuda/dsv41_ops.cu
@@ -511,3 +511,43 @@ extern "C" __global__ void tf_ds_vspan_kernel(const unsigned char* types, const
