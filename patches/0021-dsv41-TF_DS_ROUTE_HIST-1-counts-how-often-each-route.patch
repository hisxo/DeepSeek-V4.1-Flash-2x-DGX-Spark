+    /// TF_DS_ROUTE_HIST (tf_ds_route_hist_kernel): each routed slot's expert counted once in `hist` (uint32 [experts]).
+    pub fn routeHist(o: *const Ops, s: cuda.Stream, pick: u64, rows: usize, slots: usize, k: usize, hist: u64) !void {
+        var a: cuda.Args = .{};
+        a.add(pick);
+        a.add(@as(c_int, @intCast(rows)));
+        a.add(@as(c_int, @intCast(slots)));
+        a.add(@as(c_int, @intCast(k)));
+        a.add(hist);
+        try go(o.route_hist, s, (rows * k + 63) / 64, 64, &a);
+    }
