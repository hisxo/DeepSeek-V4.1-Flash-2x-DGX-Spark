From b0d8ad929706576dbb1cbfbd56f056884a693369 Mon Sep 17 00:00:00 2001
From: hisxo <hisxo@users.noreply.github.com>
Date: Mon, 23 Nov 2026 22:59:46 +0100
Subject: [PATCH 19/20] prompt cache: TF_PC_TRACE=1 explains every miss and
 every eviction

A miss on a long prompt (a resume at 0 after a 100K-token conversation
went on normally) looks the same in the log whether the client changed
the prompt's prefix or the store let the state go. With TF_PC_TRACE=1
the store logs, at each miss, the kept state sharing the longest prefix
with the prompt (how many tokens, that state's position and prompt
length, how many operations since it was used, whether it is a shared
cut, and whether the whole state matched yet was not resumed), and at
each eviction the victim and why (a later prompt extends it, or the
least recently used). Nothing else changes; the default is silent.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 zig/src/core/prompt_cache.zig | 38 +++++++++++++++++++++++++++++++++--
 1 file changed, 36 insertions(+), 2 deletions(-)

diff --git a/zig/src/core/prompt_cache.zig b/zig/src/core/prompt_cache.zig
index cb9ac8f..d72c691 100644
--- a/zig/src/core/prompt_cache.zig
+++ b/zig/src/core/prompt_cache.zig
@@ -81,10 +81,37 @@ pub const Store = struct {
 
     const SHARED_KEYS = 64;
 
+    /// TF_PC_TRACE=1: a log line for every miss (the longest kept prefix of the prompt) and every eviction (the victim
+    /// and why), to tell a prompt whose prefix changed from a state the store let go.
+    pub var trace: bool = false;
+
     pub fn init(gpa: Allocator, family: Snapshots, rules: Rules, budget: u64) Store {
+        if (std.c.getenv("TF_PC_TRACE")) |v| trace = v[0] == '1';
         return .{ .gpa = gpa, .family = family, .rules = rules, .budget = budget };
     }
 
+    /// The miss explained: the kept state sharing the longest prefix with `prompt` (a whole state that matches yet
+    /// was not resumed points at the store, a short prefix at the prompt).
+    fn explainMiss(s: *const Store, prompt: []const u32) void {
+        var best: ?*Entry = null;
+        var best_n: usize = 0;
+        for (s.entries.items) |e| {
+            const n = std.mem.indexOfDiff(u32, e.tokens, prompt) orelse @min(e.tokens.len, prompt.len);
+            if (n > best_n) {
+                best_n = n;
+                best = e;
+            }
+        }
+        if (best) |e| {
+            std.log.info("prompt cache: miss on {d} tokens: the longest kept prefix is {d} tokens, of the state at {d} of a {d}-token prompt ({d} ops ago{s}{s}); {d} states", .{ prompt.len, best_n, e.at, e.born, s.clock - e.used, if (e.shared) ", shared" else "", if (best_n == e.tokens.len) ", THE WHOLE STATE MATCHES" else "", s.entries.items.len });
+        } else std.log.info("prompt cache: miss on {d} tokens: no kept state shares a prefix; {d} states", .{ prompt.len, s.entries.items.len });
+    }
+
+    fn explainVictim(s: *const Store, i: usize, why: []const u8) void {
+        const e = s.entries.items[i];
+        std.log.info("prompt cache: evicting the state at {d} of a {d}-token prompt ({d} ops ago{s}): {s}; {d} states", .{ e.at, e.born, s.clock - e.used, if (e.shared) ", shared" else "", why, s.entries.items.len });
+    }
+
     pub fn deinit(s: *Store) void {
         for (s.entries.items) |e| s.free(e);
         s.entries.deinit(s.gpa);
@@ -150,7 +177,10 @@ pub const Store = struct {
     /// begin without the restore, for backends that restore inside their own prompt pass and then call `resumed`.
     pub fn lookup(s: *Store, a: Allocator, prompt: []const u32, history_len: u32, shared: []const u32, starts: []const u32) !Lookup {
         const e = s.recall(prompt, starts, s.find(prompt, starts));
-        if (e == null) s.counts.misses += 1;
+        if (e == null) {
+            s.counts.misses += 1;
+            if (trace and prompt.len >= s.rules.min_prompt) s.explainMiss(prompt);
+        }
         const marks_ = try s.fitting(a, try s.marks(a, prompt, if (e) |x| x.at else 0, history_len, shared, starts, if (e) |x| x.last else &.{}));
         for (shared) |w| { // the shared cuts this pass keeps: their states serve other conversations too
             const at = if (s.rules.planned) floorStart(starts, w) else w;
@@ -383,11 +413,15 @@ pub const Store = struct {
             } else false;
             if (moved_on and (best == null or e.used < s.entries.items[best.?].used)) best = i;
         }
-        if (best) |i| return i;
+        if (best) |i| {
+            if (trace) s.explainVictim(i, "a later prompt extends it");
+            return i;
+        }
         var oldest: ?usize = null;
         for (s.entries.items, 0..) |e, i| if (e != skip and (oldest == null or e.used < s.entries.items[oldest.?].used)) {
             oldest = i;
         };
+        if (trace) if (oldest) |i| s.explainVictim(i, "the least recently used");
         return oldest;
     }
 };
