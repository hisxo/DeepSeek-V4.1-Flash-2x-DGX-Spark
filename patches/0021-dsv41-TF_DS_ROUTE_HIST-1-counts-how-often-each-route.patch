From 729c64358ae9948e4d49feeac156c9316a973638 Mon Sep 17 00:00:00 2001
From: hisxo <hisxo@users.noreply.github.com>
Date: Mon, 23 Nov 2026 23:36:32 +0100
Subject: [PATCH 21/23] dsv41: TF_DS_ROUTE_HIST=1 counts how often each routed
 expert is picked

A diagnostic for the decode rounds' MoE: with TF_DS_ROUTE_HIST set, a
tiny kernel after the router (and the adaptive top-k) counts each
routed slot's expert in a per-layer histogram on the device (one atomic
add a slot, inside the CUDA graph), and tf-dsv41-lanes prints, at the
end of a run, every layer's share of its 8 / 32 / 64 most picked
experts and the top eight with their counts. It writes nothing a round
reads; unset, nothing is launched.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 zig/kernels/cuda/dsv41_ops.cu         |  9 ++++++
 zig/src/families/dsv41/lanes_main.zig | 43 +++++++++++++++++++++++++++
 zig/src/families/dsv41/ops.zig        | 13 ++++++++
 zig/src/families/dsv41/round.zig      |  7 +++++
 4 files changed, 72 insertions(+)

diff --git a/zig/kernels/cuda/dsv41_ops.cu b/zig/kernels/cuda/dsv41_ops.cu
index fab1f66..f43bb0e 100644
--- a/zig/kernels/cuda/dsv41_ops.cu
+++ b/zig/kernels/cuda/dsv41_ops.cu
@@ -551,3 +551,12 @@ extern "C" __global__ void tf_ds_route_trim_kernel(int* pick, float* wts, int ro
             if (p[q] < 0) w[q] = 0.f;
     }
 }
+
+// TF_DS_ROUTE_HIST: how often each routed expert is picked. One thread a (row, routed slot): the slot's expert (-1:
+// unrouted) counts once in this layer's histogram. A diagnostic; it writes nothing the round reads.
+extern "C" __global__ void tf_ds_route_hist_kernel(const int* pick, int rows, int slots, int k, unsigned int* hist) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= rows * k) return;
+    const int e = pick[(size_t)(i / k) * slots + (i % k)];
+    if (e >= 0) atomicAdd(hist + e, 1u);
+}
