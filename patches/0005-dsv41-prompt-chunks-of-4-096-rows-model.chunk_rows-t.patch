From 68ffd8892a062e668dd3d9d64082b15177667fa5 Mon Sep 17 00:00:00 2001
From: hisxo <16657045+hisxo@users.noreply.github.com>
Date: Sun, 11 Oct 2026 17:44:06 +0000
Subject: [PATCH 5/5] dsv41: prompt chunks of 4,096 rows (model.chunk_rows, the
 server's prompt_rows)

Fewer and larger launches a prompt: per token, the MoE takes 7 % less, the
TP2 all-gathers 10 % less and the attention 3 % less. 5-6 % faster prefill
on two GB10s (8K-128K prompts), the same first tokens; the arena grows by
~2.5 GB a rank.
---
 zig/src/families/dsv41/model.zig  | 2 +-
 zig/src/families/dsv41/native.zig | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/zig/src/families/dsv41/model.zig b/zig/src/families/dsv41/model.zig
index a4718cc..62120e3 100644
--- a/zig/src/families/dsv41/model.zig
+++ b/zig/src/families/dsv41/model.zig
@@ -29,7 +29,7 @@ const ring2d = @import("ring2d.zig");
 const rdma = @import("rdma.zig");
 
 /// The served prompt chunk (TF_DS_PREFILL_CHUNK): a prompt runs in chunks that start at its multiples.
-pub const chunk_rows = 2048;
+pub const chunk_rows = 4096;
 /// The pool's streams (--parallel 4).
 pub const max_streams = draft.max_streams;
 /// The pool's streams when unset (--parallel 4).
diff --git a/zig/src/families/dsv41/native.zig b/zig/src/families/dsv41/native.zig
index 55a532f..6ea6577 100644
--- a/zig/src/families/dsv41/native.zig
+++ b/zig/src/families/dsv41/native.zig
@@ -40,7 +40,7 @@ pub const formats: []const []const u8 = &.{"exl3-mul1"};
 pub const default_context: i64 = 262144;
 pub const max_segments: u32 = 1;
 /// The served build's prompt chunk (TF_DS_PREFILL_CHUNK).
-pub const prompt_rows: u32 = 2048;
+pub const prompt_rows: u32 = 4096;
 /// The served lane's reasoning effort numbers (text.zig): the server passes each name and the template hears its number.
 pub const efforts = @import("text.zig").efforts;
 
