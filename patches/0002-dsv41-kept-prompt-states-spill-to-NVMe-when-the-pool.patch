index fc30d3c..0d4ad62 100644
--- a/zig/src/families/dsv41/model.zig
+++ b/zig/src/families/dsv41/model.zig
@@ -486,6 +486,60 @@ pub const Model = struct {
         }
     }
 
+    /// The bytes of an extent's compressed rows for positions [0, at): every kv-source layer's codes and scales and its
+    /// index keys, as copyExtent moves them.
+    pub fn extentBytes(m: *const Model, at: usize) usize {
+        const c = m.eng.c;
+        var n: usize = 0;
+        for (m.eng.w.layers) |lay| {
+            if (lay.comp_wkv == null) continue;
+            const rows = at / @as(usize, lay.ratio);
+            n += rows * (c.head_dim / 2 + c.head_dim / 16);
+            if (lay.idx_wk != null) n += rows * (c.index_head_dim / 2 + c.index_head_dim / 32);
+        }
+        return n;
+    }
+
+    /// The extent at `base`'s compressed rows [0, at) streamed through `bounce` (4 KiB-aligned) into file `fd` (save)
+    /// or back from it, in copyExtent's order, each piece at a 4 KiB-aligned file offset (O_DIRECT); every copy
+    /// synchronized before its piece is reused. Returns the file's bytes.
+    pub fn diskExtent(m: *Model, base: usize, at: usize, fd: std.c.fd_t, bounce: []align(4096) u8, save: bool) !u64 {
+        const c = m.eng.c;
+        const cs = &m.caches;
+        const d = m.ctx.d;
+        var foff: u64 = 0;
+        for (m.eng.w.layers, 0..) |lay, i| {
+            if (lay.comp_wkv == null) continue;
+            const r: usize = lay.ratio;
+            if (base % r != 0 or at % r != 0) return error.BadView;
+            const n = at / r;
+            const planes = [4]u64{ cs.comp_codes[i], cs.comp_scales[i], cs.idx_codes[i], cs.idx_scales[i] };
+            const widths = [4]usize{ c.head_dim / 2, c.head_dim / 16, c.index_head_dim / 2, c.index_head_dim / 32 };
+            for (planes, widths, 0..) |plane, row, k| {
+                if (k >= 2 and lay.idx_wk == null) continue;
+                const bytes = n * row;
+                const dev: u64 = plane + @as(u64, base / r) * row;
+                var done: usize = 0;
+                while (done < bytes) {
+                    const piece = @min(bounce.len, bytes - done);
+                    const padded = std.mem.alignForward(usize, piece, 4096);
+                    if (save) {
+                        try d.check(d.api.cuMemcpyDtoHAsync_v2(@ptrCast(bounce.ptr), dev + done, piece, m.stream.handle), "cuMemcpyDtoHAsync");
+                        try m.stream.synchronize();
+                        try pwriteAll(fd, bounce[0..padded], foff);
+                    } else {
+                        try preadAll(fd, bounce[0..padded], foff);
+                        try d.check(d.api.cuMemcpyHtoDAsync_v2(dev + done, @ptrCast(bounce.ptr), piece, m.stream.handle), "cuMemcpyHtoDAsync");
+                        try m.stream.synchronize();
+                    }
+                    foff += padded;
+                    done += piece;
+                }
+            }
+        }
+        return foff;
+    }
+
     fn copySpan(m: *Model, plane: u64, from: usize, to: usize, n: usize, row: usize) !void {
         const d = m.ctx.d;
         try d.check(d.api.cuMemcpyDtoDAsync_v2(plane + to * row, plane + from * row, n * row, m.stream.handle), "cuMemcpyDtoDAsync");
@@ -767,3 +821,31 @@ pub const Model = struct {
         try dr.pass(&m.eng, &m.ch, pool, tokens, q0, slots, steps, null);
     }
 };
+
+/// Every byte of `buf` written at `off` (EINTR retried).
+fn pwriteAll(fd: std.c.fd_t, buf: []const u8, off: u64) !void {
+    var done: usize = 0;
+    while (done < buf.len) {
+        const n = std.c.pwrite(fd, buf.ptr + done, buf.len - done, @intCast(off + done));
+        if (n < 0) {
+            if (std.c.errno(n) == .INTR) continue;
+            return error.SpillWrite;
+        }
+        if (n == 0) return error.SpillWrite;
+        done += @intCast(n);
+    }
+}
+
+/// `buf` filled from `off` (EINTR retried; a short file is an error).
+fn preadAll(fd: std.c.fd_t, buf: []u8, off: u64) !void {
+    var done: usize = 0;
+    while (done < buf.len) {
+        const n = std.c.pread(fd, buf.ptr + done, buf.len - done, @intCast(off + done));
+        if (n < 0) {
+            if (std.c.errno(n) == .INTR) continue;
+            return error.SpillRead;
+        }
+        if (n == 0) return error.SpillShort;
+        done += @intCast(n);
+    }
+}
diff --git a/zig/src/families/dsv41/spill.zig b/zig/src/families/dsv41/spill.zig
new file mode 100644
index 0000000..8b3e853
--- /dev/null
+++ b/zig/src/families/dsv41/spill.zig
@@ -0,0 +1,92 @@
+//! Kept prompt states' compressed rows on disk. With TF_DS_SPILL_DIR set (at most TF_DS_SPILL_GIB, default 48), a
+//! kept state whose extent a new stream needs is written out instead of going stale, and when its prompt comes back
+//! its rows are read into a free extent: a long agent session resumes after other sessions crowded it out of the pool.
+//! Each rank writes its own rows (rank 1 on rank 0's snap_spill frame); a state's file is removed when it is dropped.
+const std = @import("std");
+const Model = @import("model.zig").Model;
+
+pub const Spill = struct {
+    dir: []const u8 = "",
+    cap: u64 = 0,
+    used: u64 = 0,
+    rank: u32 = 0,
+    bounce: []align(4096) u8 = &.{},
+    files: std.AutoHashMapUnmanaged(u64, u64) = .empty, // state id -> its file's bytes
+
+    pub const piece_bytes = 64 << 20;
+
+    pub fn fromEnv(gpa: std.mem.Allocator, rank: u32) Spill {
+        const d = std.c.getenv("TF_DS_SPILL_DIR") orelse return .{};
+        const dir = std.mem.span(d);
+        if (dir.len == 0) return .{};
+        const gib: u64 = if (std.c.getenv("TF_DS_SPILL_GIB")) |v| std.fmt.parseInt(u64, std.mem.span(v), 10) catch 48 else 48;
+        const b = gpa.alignedAlloc(u8, .fromByteUnits(4096), piece_bytes) catch return .{};
+        std.log.info("spill: kept prompts' rows to {s} (at most {d} GiB)", .{ dir, gib });
+        return .{ .dir = dir, .cap = gib << 30, .rank = rank, .bounce = b };
+    }
+
+    pub fn on(s: *const Spill) bool {
+        return s.dir.len > 0 and s.bounce.len > 0;
+    }
+
+    pub fn deinit(s: *Spill, gpa: std.mem.Allocator) void {
+        var it = s.files.keyIterator();
+        while (it.next()) |id| s.unlinkFile(id.*);
+        s.files.deinit(gpa);
+        if (s.bounce.len > 0) gpa.free(s.bounce);
+        s.* = .{};
+    }
+
+    fn path(s: *const Spill, buf: []u8, id: u64) ![:0]const u8 {
+        return std.fmt.bufPrintSentinel(buf, "{s}/spill-r{d}-{d}.kv", .{ s.dir, s.rank, id }, 0);
+    }
+
+    fn unlinkFile(s: *const Spill, id: u64) void {
+        var pb: [1024]u8 = undefined;
+        const p = s.path(&pb, id) catch return;
+        _ = std.c.unlink(p);
+    }
+
+    pub fn has(s: *const Spill, id: u64) bool {
+        return s.files.contains(id);
+    }
+
+    /// State `id`'s rows (the extent at `base`, positions [0, at)) written to its file; error.SpillFull past the cap.
+    pub fn write(s: *Spill, gpa: std.mem.Allocator, m: *Model, id: u64, base: usize, at: usize) !void {
+        if (!s.on()) return error.SpillOff;
+        if (s.files.contains(id)) return; // its rows never change while it lives: the file stands
+        const est = m.extentBytes(at) + 64 * 4096;
+        if (s.used + est > s.cap) return error.SpillFull;
+        var pb: [1024]u8 = undefined;
+        const p = try s.path(&pb, id);
+        var fd = std.c.open(p, .{ .ACCMODE = .WRONLY, .CREAT = true, .TRUNC = true, .CLOEXEC = true, .DIRECT = true }, @as(std.c.mode_t, 0o600));
+        if (fd < 0) fd = std.c.open(p, .{ .ACCMODE = .WRONLY, .CREAT = true, .TRUNC = true, .CLOEXEC = true }, @as(std.c.mode_t, 0o600));
+        if (fd < 0) return error.SpillOpen;
+        defer _ = std.c.close(fd);
+        const bytes = m.diskExtent(base, at, fd, s.bounce, true) catch |err| {
+            _ = std.c.unlink(p);
+            return err;
+        };
+        try s.files.put(gpa, id, bytes);
+        s.used += bytes;
+    }
+
+    /// State `id`'s rows read from its file into the extent at `to`.
+    pub fn read(s: *Spill, m: *Model, id: u64, to: usize, at: usize) !void {
+        if (!s.files.contains(id)) return error.NotSpilled;
+        var pb: [1024]u8 = undefined;
+        const p = try s.path(&pb, id);
+        var fd = std.c.open(p, .{ .ACCMODE = .RDONLY, .CLOEXEC = true, .DIRECT = true }, @as(std.c.mode_t, 0));
+        if (fd < 0) fd = std.c.open(p, .{ .ACCMODE = .RDONLY, .CLOEXEC = true }, @as(std.c.mode_t, 0));
+        if (fd < 0) return error.SpillOpen;
+        defer _ = std.c.close(fd);
+        _ = try m.diskExtent(to, at, fd, s.bounce, false);
+    }
+
+    /// State `id`'s file removed (the state is dropped).
+    pub fn forget(s: *Spill, id: u64) void {
+        const kv = s.files.fetchRemove(id) orelse return;
+        s.used -|= kv.value;
+        s.unlinkFile(id);
+    }
+};
