     try w.flush();
     return if (all_equal) 0 else 1;
@@ -350,3 +351,45 @@ fn printClock(w: *std.Io.Writer, rank: u32, m: *const dsv41.model.Model) !void {
     try w.print("}}}}\n", .{});
     try w.flush();
 }
+
+/// TF_DS_ROUTE_HIST: each layer's routed-expert histogram (every routed slot of every decode row counted), as the
+/// share of the 8 / 32 / 64 most picked experts and the top eight with their counts.
+fn printRouteHist(w: anytype, m: *dsv41.model.Model) !void {
+    const rd = &m.rd;
+    if (rd.hist == 0) return;
+    const c = m.eng.c;
+    const gpa = std.heap.page_allocator;
+    const n = c.layers * c.experts;
+    const hist = try gpa.alloc(u32, n);
+    defer gpa.free(hist);
+    try m.stream.synchronize();
+    const d = m.ctx.d;
+    try d.check(d.api.cuMemcpyDtoH_v2(hist.ptr, rd.hist, n * 4), "cuMemcpyDtoH");
+    const idx = try gpa.alloc(u32, c.experts);
+    defer gpa.free(idx);
+    const Ctx = struct {
+        row: []const u32,
+        fn less(ctx: @This(), x: u32, y: u32) bool {
+            return ctx.row[x] > ctx.row[y];
+        }
+    };
+    for (0..c.layers) |li| {
+        const row = hist[li * c.experts ..][0..c.experts];
+        var total: u64 = 0;
+        for (row) |v| total += v;
+        if (total == 0) continue;
+        for (idx, 0..) |*x, i| x.* = @intCast(i);
+        std.mem.sort(u32, idx, Ctx{ .row = row }, Ctx.less);
+        var top: [3]u64 = .{ 0, 0, 0 };
+        for (idx[0..@min(64, idx.len)], 0..) |x, i| {
+            if (i < 8) top[0] += row[x];
+            if (i < 32) top[1] += row[x];
+            top[2] += row[x];
+        }
+        const t: f64 = @floatFromInt(total);
+        try w.print("{{\"rank\": 0, \"route_hist\": {{\"layer\": {d}, \"slots\": {d}, \"top8\": {d:.3}, \"top32\": {d:.3}, \"top64\": {d:.3}, \"top\": [", .{ li, total, @as(f64, @floatFromInt(top[0])) / t, @as(f64, @floatFromInt(top[1])) / t, @as(f64, @floatFromInt(top[2])) / t });
+        for (idx[0..@min(8, idx.len)], 0..) |x, i| try w.print("{s}[{d}, {d}]", .{ if (i == 0) "" else ", ", x, row[x] });
+        try w.print("]}}}}\n", .{});
+    }
+    try w.flush();
+}
